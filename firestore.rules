rules_version = '2';

/* The Boson Line - shared pick sheet.

   There is no sign-in. Anonymous auth was the obvious thing to require here, but
   it is not a real gate: anyone can mint an anonymous token in a single call, so
   requiring one would have bought nothing except an extra product to configure.

   What these rules do enforce is that a caller can only ever touch the 18 week
   documents of this one season, can only store the four fields the app knows
   about, and cannot read or write anything else in the project. Picks are small
   and replaceable. The practical protection for a family sheet is that the URL
   is not advertised.

   'touch' is a map of {bo|dad: serverTimestamp} written alongside every save, so
   each phone can show when the other person last changed something. It is a
   courtesy signal, not a credential: anyone who can write picks can write it.

   To lock this down properly later: enable a real sign-in provider (Google) in
   the Firebase console, then gate on the two account IDs -
       allow read, write: if request.auth.uid in ['UID_ONE', 'UID_TWO'];
   and have docs/assets/store.js sign in before it reads. */

service cloud.firestore {
  match /databases/{database}/documents {

    match /seasons/2026/weeks/{week} {
      allow read: if true;

      allow write: if week.matches('^w([1-9]|1[0-8])$')
        && request.resource.data.keys().hasOnly(['picks', 'results', 'touch', 'updatedAt'])
        && (!('picks' in request.resource.data) || request.resource.data.picks is map)
        && (!('results' in request.resource.data) || request.resource.data.results is map)
        && (!('touch' in request.resource.data) || request.resource.data.touch is map)
        && (!('picks' in request.resource.data) || request.resource.data.picks.size() <= 16)
        && (!('results' in request.resource.data) || request.resource.data.results.size() <= 16)
        && (!('touch' in request.resource.data) || request.resource.data.touch.size() <= 8);
    }

    /* The shared roster: who is playing and what each of them is called. Same
       trust model as the picks - anyone with the link can change it - but it is
       bounded to eight entries of two short fields so it cannot become storage. */
    match /seasons/2026/meta/roster {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['players', 'updatedAt'])
        && request.resource.data.players is list
        && request.resource.data.players.size() >= 1
        && request.resource.data.players.size() <= 8;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
